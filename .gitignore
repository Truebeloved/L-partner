# ---- dependencies ----
node_modules/
.pnp
.pnp.js

# ---- build output ----
dist/
dist-ssr/
build/
out/
*.tsbuildinfo

# ---- 桌面端打包产物 ----
# 安装包不进仓库：几十上百 MB 的二进制会让仓库迅速膨胀，
# 正确做法是挂到 GitHub Releases 上（见 README）
release/
dist-electron/
*.exe
*.msi
*.dmg
*.AppImage
*.blockmap

# ---- local env (never commit real keys) ----
.env
.env.local
.env.*.local
!.env.example

# ---- logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- test / coverage ----
coverage/
.vitest/
playwright-report/
test-results/

# ---- caches ----
.cache/
.temp/
tmp/
.eslintcache
.vite/

# ---- editors / OS ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
*.swp
*~

# ---- local notes ----
notes-local/

# ---- UI 截图（scripts/capture-ui.cjs 的产物，仅供本地比对） ----
.ui-shots/

# 教材正文（导入用户应用数据用的一次性产物）
.lessons/
